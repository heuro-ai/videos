    "compositions": "remotion compositions src/index.jsx"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.541"
  }
}
